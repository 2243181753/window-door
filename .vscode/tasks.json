{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "视窗之门: Build",
      "type": "shell",
      "command": "./dev-build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "视窗之门: Run",
      "type": "shell",
      "command": "./run.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "视窗之门: Test",
      "type": "shell",
      "command": "./test.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "视窗之门: 调试",
      "type": "shell",
      "command": "./build.sh debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
